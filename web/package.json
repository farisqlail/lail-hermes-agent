{
  "name": "hermes-web",
  "version": "1.0.0",
  "description": "Hermes React Web UI",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node node_modules/next/dist/bin/next build && node build.mjs --copy-out",
    "dev": "node node_modules/next/dist/bin/next dev",
    "next:build": "node node_modules/next/dist/bin/next build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "npm run typecheck && node test.mjs"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@types/three": "^0.185.4",
    "lucide-react": "^1.34.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.3"
  }
}
