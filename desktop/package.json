{
  "name": "hermes-desktop",
  "version": "0.0.6",
  "description": "Hermes AI Agent - Native Windows Desktop Application",
  "main": "src/main.js",
  "author": "LAIL Hermes Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "build:all": "npm run dist"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lail.hermes.desktop",
    "productName": "Lail Hermes",
    "copyright": "Copyright © 2026 LAIL Hermes Agent",
    "asar": true,
    "directories": {
      "output": "../dist",
      "buildResources": "assets"
    },
    "publish": {
      "provider": "github",
      "owner": "farisqlail",
      "repo": "lail-hermes-agent"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist-backend/hermes-engine",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Lail-Hermes-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Lail-Hermes-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lail Hermes",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
